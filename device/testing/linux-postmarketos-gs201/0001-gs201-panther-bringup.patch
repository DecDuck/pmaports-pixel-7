+/*
+ * Newer firmware (e.g. BCM4389) checks that each message on the H2D common
+ * rings carries the ring's running sequence number in the common header's
+ * epoch byte, and traps ("h2d livelock error") otherwise. TX flow ring items
+ * use that byte differently and must not be stamped. Stamp all items written
+ * since the last commit.
+ */
+static void brcmf_commonring_stamp(struct brcmf_commonring *commonring)
+{
+	u16 idx = commonring->f_ptr;
+
+	if (!commonring->stamp_epoch)
+		return;
+
+	while (idx != commonring->w_ptr) {
+		u8 *item = commonring->buf_addr + idx * commonring->item_len;
+
+		item[BRCMF_H2D_EPOCH_OFFSET] =
+			commonring->seqnum % BRCMF_H2D_EPOCH_MODULO;
+		commonring->seqnum++;
+		if (++idx == commonring->depth)
+			idx = 0;
+	}
+}
