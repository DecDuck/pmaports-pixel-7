+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S2MPG12 (Google gs201 main PMIC) regulator driver
+ *
+ * The PMIC is accessed through the ACPM firmware (see sec-acpm). Register
+ * layout and voltage tables are from Google's downstream s2mpg12 driver.
+ * Regulators are only switched fully on (all enable bits, "ON in normal
+ * mode") or off; external/suspend control modes are left as configured
+ * by the bootloader.
+ */
+
+#include <linux/bits.h>
+#include <linux/mfd/samsung/core.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+
+#define S2MPG12_ENABLE_TIME_LDO		128
+#define S2MPG12_ENABLE_TIME_BUCK	130
+
+enum s2mpg12_regulator_id {
+	S2MPG12_LDO1,
+	S2MPG12_LDO2,
+	S2MPG12_LDO3,
+	S2MPG12_LDO4,
+	S2MPG12_LDO5,
+	S2MPG12_LDO6,
+	S2MPG12_LDO7,
+	S2MPG12_LDO8,
+	S2MPG12_LDO9,
+	S2MPG12_LDO10,
+	S2MPG12_LDO11,
+	S2MPG12_LDO12,
+	S2MPG12_LDO13,
+	S2MPG12_LDO14,
+	S2MPG12_LDO15,
+	S2MPG12_LDO16,
+	S2MPG12_LDO17,
+	S2MPG12_LDO18,
+	S2MPG12_LDO19,
+	S2MPG12_LDO20,
+	S2MPG12_LDO21,
+	S2MPG12_LDO22,
+	S2MPG12_LDO23,
+	S2MPG12_LDO24,
+	S2MPG12_LDO25,
+	S2MPG12_LDO26,
+	S2MPG12_LDO27,
+	S2MPG12_LDO28,
+	S2MPG12_BUCK1,
+	S2MPG12_BUCK2,
+	S2MPG12_BUCK3,
+	S2MPG12_BUCK4,
+	S2MPG12_BUCK5,
+	S2MPG12_BUCK6,
+	S2MPG12_BUCK7,
