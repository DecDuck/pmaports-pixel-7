--- /dev/null
+++ b/include/linux/mfd/samsung/s2mpg12.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Samsung S2MPG12 (gs201 main PMIC) register definitions.
+ */
+
+#ifndef __LINUX_MFD_S2MPG12_H
+#define __LINUX_MFD_S2MPG12_H
+
+#include <linux/bits.h>
+
+/* Common block */
+#define S2MPG12_COMMON_IBI0		0x05
+#define S2MPG12_COMMON_CHIPID		0x0b
+#define S2MPG12_COMMON_IBIM1		0x0f
+
+/* For S2MPG12_COMMON_IBI0 and S2MPG12_COMMON_IBIM1 */
+#define S2MPG12_COMMON_INT_SRC_PMIC	BIT(0)
+
+enum s2mpg12_common_irq {
+	S2MPG12_COMMON_IRQ_PMIC,
+	S2MPG12_COMMON_IRQ_UNUSED,
+};
+
+/* PM block: INT1..INT5 status, INT1M..INT5M masks */
+#define S2MPG12_PMIC_INT1		0x00
+#define S2MPG12_PMIC_INT1M		0x05
+#define S2MPG12_PMIC_NUM_IRQ_REGS	5
+
+/*
+ * INT1 (power key, ACOK, ...) and INT2 (RTC, WTSR, SMPL) are bit-compatible
+ * with S2MPG10, so the S2MPG10_IRQ_* indices and masks are reused for them.
+ */
+
+#endif /* __LINUX_MFD_S2MPG12_H */
