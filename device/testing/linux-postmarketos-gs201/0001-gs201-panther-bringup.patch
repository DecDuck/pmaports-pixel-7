+	.nr_gate_clks	= ARRAY_SIZE(peric1_gate_clks),
+	.nr_clk_ids		= 12,
+};
+
+static void __init gs201_cmu_peric1_init(struct device_node *np)
+{
+	exynos_arm64_register_cmu(NULL, np, &peric1_cmu_info);
+}
+
+CLK_OF_DECLARE(gs201_cmu_peric1, "google,gs201-cmu-peric1", gs201_cmu_peric1_init);
+
+PNAME(mux_clkcmu_apm_func_p) = { "oscclk", "mux_clkcmu_apm_funcsrc", "pad_clk_apm", "oscclk" };
+PNAME(mux_clkcmu_apm_funcsrc_p) = { "pll_alv_div2_apm", "pll_alv_div4_apm", "pll_alv_div16_apm", "pll_alv_div8_apm" };
+
+static const struct samsung_fixed_rate_clock apm_fixed_clks[] __initconst = {
+	FRATE(CLK_GS201_PLL_ALV_DIV2_APM, "pll_alv_div2_apm", NULL, 0, 394000000),
+	FRATE(CLK_GS201_PLL_ALV_DIV4_APM, "pll_alv_div4_apm", NULL, 0, 197000000),
+	FRATE(CLK_GS201_PLL_ALV_DIV16_APM, "pll_alv_div16_apm", NULL, 0, 50000000),
+	FRATE(CLK_GS201_PLL_ALV_DIV8_APM, "pll_alv_div8_apm", NULL, 0, 99000000),
+	FRATE(CLK_GS201_PAD_CLK_APM, "pad_clk_apm", NULL, 0, 100000000),
+};
+
+static const struct samsung_mux_clock apm_mux_clks[] __initconst = {
+	MUX(CLK_GS201_MUX_CLKCMU_APM_FUNC, "mux_clkcmu_apm_func", mux_clkcmu_apm_func_p,
+	    CLK_CON_MUX_MUX_CLKCMU_APM_FUNC, 0, 2),
+	MUX(CLK_GS201_MUX_CLKCMU_APM_FUNCSRC, "mux_clkcmu_apm_funcsrc", mux_clkcmu_apm_funcsrc_p,
+	    CLK_CON_MUX_MUX_CLKCMU_APM_FUNCSRC, 0, 2),
+};
+
+static const struct samsung_gate_clock apm_gate_clks[] __initconst = {
+	GATE(CLK_GS201_GOUT_BLK_APM_UID_MAILBOX_APM_AP_IPCLKPORT_PCLK, "gout_blk_apm_uid_mailbox_apm_ap_ipclkport_pclk", "gate_clkcmu_apm_func",
+	     CLK_CON_GAT_GOUT_BLK_APM_UID_MAILBOX_APM_AP_IPCLKPORT_PCLK, 21, CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GS201_GATE_CLKCMU_APM_FUNC, "gate_clkcmu_apm_func", "mux_clkcmu_apm_func",
+	     CLK_CON_GAT_GATE_CLKCMU_APM_FUNC, 21, CLK_IGNORE_UNUSED, 0),
+};
+
+static const struct samsung_cmu_info apm_cmu_info __initconst = {
+	.fixed_clks		= apm_fixed_clks,
+	.nr_fixed_clks	= ARRAY_SIZE(apm_fixed_clks),
+	.mux_clks		= apm_mux_clks,
+	.nr_mux_clks	= ARRAY_SIZE(apm_mux_clks),
+	.gate_clks		= apm_gate_clks,
+	.nr_gate_clks	= ARRAY_SIZE(apm_gate_clks),
+	.nr_clk_ids		= 10,
+};
+
+static void __init gs201_cmu_apm_init(struct device_node *np)
+{
+	exynos_arm64_register_cmu(NULL, np, &apm_cmu_info);
+}
+
+CLK_OF_DECLARE(gs201_cmu_apm, "google,gs201-cmu-apm", gs201_cmu_apm_init);
