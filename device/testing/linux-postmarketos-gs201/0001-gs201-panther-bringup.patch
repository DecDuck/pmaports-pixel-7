+		reg = <0x0 0x18070000 0x10000>;
+	};
+
+	pmu_system_controller: system-controller@18060000 {
+		compatible = "google,gs201-pmu", "google,gs101-pmu";
+		reg = <0x0 0x18060000 0x10000>;
+		google,pmu-intr-gen-syscon = <&pmu_intr_gen>;
