+
+static const struct gs201_reg_val gs201_pma_lane_clk[] = {
+	{ 0xbcc, 0x41 }, { 0xbd4, 0x41 }, { 0xbdc, 0x68 }, { 0xbe0, 0x00 },
+	{ 0xbe4, 0xd0 },
+};
+
+static void gs201_write_table(void __iomem *base, const struct gs201_reg_val *t,
+			      int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		writel(t[i].val, base + t[i].reg);
+}
+
+static void gs201_pcs_rmw(struct gs201_pcie *gp, u32 off, u32 clr, u32 set)
+{
+	int lane;
+
+	for (lane = 0; lane < gp->num_lanes; lane++) {
+		void __iomem *r = gp->pcs + off + lane * 0x800;
+
+		writel((readl(r) & ~clr) | set, r);
+	}
+}
+
+static void gs201_pcs_write(struct gs201_pcie *gp, u32 off, u32 val)
+{
+	int lane;
+
+	for (lane = 0; lane < gp->num_lanes; lane++)
+		writel(val, gp->pcs + off + lane * 0x800);
+}
+
+static void gs201_pcie_phy_config(struct gs201_pcie *gp)
+{
+	int lane;
+	u32 val;
+
+	/* input clock path */
+	writel(0x28, gp->phy + 0xd8);
+
+	/* PCS mux glitch workaround */
+	gs201_pcs_rmw(gp, 0x008, 0, BIT(7));
+
+	/* PHY CMN/INIT/PORT reset pulse, then hold PORT and INIT in reset */
+	writel(1, gp->pci.elbi_base + ELBI_PHY_CMN_RST);
+	writel(1, gp->pci.elbi_base + ELBI_PHY_INIT_RST);
+	writel(1, gp->pci.elbi_base + ELBI_PHY_PORT_RST);
+	writel(0, gp->pci.elbi_base + ELBI_PHY_CMN_RST);
+	writel(0, gp->pci.elbi_base + ELBI_PHY_INIT_RST);
+	writel(0, gp->pci.elbi_base + ELBI_PHY_PORT_RST);
+	udelay(10);
+	writel(1, gp->pci.elbi_base + ELBI_PHY_CMN_RST);
+	udelay(10);
+
+	gs201_write_table(gp->phy, gs201_pma_common,
+			  ARRAY_SIZE(gs201_pma_common));
+
+	for (lane = 0; lane < gp->num_lanes; lane++)
+		gs201_write_table(gp->phy + lane * 0x800, gs201_pma_lane,
+				  ARRAY_SIZE(gs201_pma_lane));
+	for (lane = 0; lane < 2; lane++)
+		gs201_write_table(gp->phy + lane * 0x800, gs201_pma_lane_clk,
+				  ARRAY_SIZE(gs201_pma_lane_clk));
+
+	/* PCS: aggregation mode, RC, L2 power settings */
+	gs201_pcs_write(gp, 0x004, 0x00);
+	gs201_pcs_write(gp, 0x154, 0x700d5);
+	gs201_pcs_write(gp, 0x150, 0x300ff);
+	gs201_pcs_write(gp, 0x170, 0x40);
+	/* ERIO clock gating in L1.2 */
+	gs201_pcs_rmw(gp, 0x008, BIT(4) | BIT(5), BIT(4));
+	/* PLL & bias enable off delay */
+	writel(0x100b0808, gp->pcs + 0x190);
+
+	/* release PHY PORT and INIT reset */
+	writel(1, gp->pci.elbi_base + ELBI_PHY_PORT_RST);
+	writel(1, gp->pci.elbi_base + ELBI_PHY_INIT_RST);
+
+	/* XO clock configuration */
+	val = readl(gp->phy + 0x5d0);
+	val |= BIT(4);
+	val &= ~BIT(3);
+	writel(val, gp->phy + 0x5d0);
+}
+
+static irqreturn_t gs201_pcie_irq(int irq, void *data)
+{
+	struct gs201_pcie *gp = data;
+	u32 s0 = readl(gp->pci.elbi_base + ELBI_IRQ0);
+	u32 s1 = readl(gp->pci.elbi_base + ELBI_IRQ1);
+	u32 s2 = readl(gp->pci.elbi_base + ELBI_IRQ2);
+
+	/* status bits are write-1-to-clear */
+	writel(s0, gp->pci.elbi_base + ELBI_IRQ0);
+	writel(s1, gp->pci.elbi_base + ELBI_IRQ1);
+	writel(s2, gp->pci.elbi_base + ELBI_IRQ2);
+
+	if (s2 & ELBI_IRQ2_MSI)
+		dw_handle_msi_irq(&gp->pci.pp);
+
+	return (s0 | s1 | s2) ? IRQ_HANDLED : IRQ_NONE;
+}
+
+static int gs201_pcie_host_init(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct gs201_pcie *gp = to_gs201_pcie(pci);
+	struct device *dev = pci->dev;
+	u16 offset;
+	u32 val;
+	int ret;
+
+	gpiod_set_value_cansleep(gp->perst, 1);
+
+	if (gp->vpcie) {
+		ret = regulator_enable(gp->vpcie);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to enable vpcie\n");
+	}
+
+	/* Release PHY isolation; the controller is unreachable until then */
+	ret = regmap_update_bits(gp->pmu, gp->pmu_offset,
+				 PMU_PCIE_PHY_BYPASS, PMU_PCIE_PHY_BYPASS);
+	if (ret)
+		goto err_reg;
+
+	gs201_pcie_phy_pwrdn_clear(gp);
+	gs201_pcie_phy_config(gp);
+
+	regmap_update_bits(gp->pmu, gp->pmu_offset, PMU_PCIE_PHY_EXTRA,
+			   PMU_PCIE_PHY_EXTRA);
+	writel(0x421, gp->udbg + 0xc800);
+	writel(0, gp->phy + 0x32c);
+
+	/* equalization off */
+	dw_pcie_writel_dbi(pci, PCIE_GEN3_RELATED_OFF_EQ, 0x12000);
+
+	gpiod_set_value_cansleep(gp->perst, 0);
+	msleep(20);
+
+	val = readl(gp->pci.elbi_base + ELBI_APP_REQ_EXIT_L1_MODE);
+	val |= ELBI_APP_REQ_EXIT_L1_MODE_SW | ELBI_L1_REQ_NAK_CONTROL_MASTER;
+	writel(val, gp->pci.elbi_base + ELBI_APP_REQ_EXIT_L1_MODE);
+	writel(ELBI_LINKDOWN_RST_MANUAL, gp->pci.elbi_base + ELBI_LINKDOWN_RST_CTRL_SEL);
+	writel(1, gp->pci.elbi_base + ELBI_APP_XFER_PENDING);
+	val = readl(gp->pci.elbi_base + ELBI_QCH_SEL);
+	writel(val & ~ELBI_QCH_CLOCK_GATING_MASK, gp->pci.elbi_base + ELBI_QCH_SEL);
+	writel(1, gp->pci.elbi_base + ELBI_MSTR_PEND_SEL_NAK);
+	writel(1, gp->pci.elbi_base + ELBI_DBI_L1_EXIT_DISABLE);
+
+	dw_pcie_dbi_ro_wr_en(pci);
+	/*
+	 * L1 entry/exit isn't handled by this glue (downstream manages L1
+	 * itself); with ASPM L1 enabled the link drops and the endpoint resets.
+	 */
+	offset = dw_pcie_find_capability(pci, PCI_CAP_ID_EXP);
+	val = dw_pcie_readl_dbi(pci, offset + PCI_EXP_LNKCAP);
+	dw_pcie_writel_dbi(pci, offset + PCI_EXP_LNKCAP,
+			   val & ~PCI_EXP_LNKCAP_ASPMS);
+	dw_pcie_writel_dbi(pci, PCIE_AUX_CLK_FREQ_OFF, PCIE_AUX_CLK_FREQ_26MHZ);
+	dw_pcie_writel_dbi(pci, PCIE_L1_SUBSTATES_OFF, PCIE_L1_SUB_VAL);
+	dw_pcie_dbi_ro_wr_dis(pci);
+
+	/* MSIs from the iMSI-RX module are signalled through IRQ2 */
+	writel(0, gp->pci.elbi_base + ELBI_IRQ0_EN);
+	writel(0, gp->pci.elbi_base + ELBI_IRQ1_EN);
+	writel(ELBI_IRQ2_MSI, gp->pci.elbi_base + ELBI_IRQ2_EN);
+
+	/* the handler needs ELBI, which the DWC core maps just before init */
+	if (!gp->irq_requested) {
+		ret = devm_request_irq(dev, gp->irq, gs201_pcie_irq, IRQF_SHARED,
+				       "gs201-pcie", gp);
+		if (ret)
+			goto err_reg;
+		gp->irq_requested = true;
+	}
+
+	return 0;
+
+err_reg:
+	if (gp->vpcie)
+		regulator_disable(gp->vpcie);
+	return ret;
+}
+
+static void gs201_pcie_host_deinit(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct gs201_pcie *gp = to_gs201_pcie(pci);
+
+	writel(0, gp->pci.elbi_base + ELBI_APP_LTSSM_ENABLE);
+	gpiod_set_value_cansleep(gp->perst, 1);
+	regmap_update_bits(gp->pmu, gp->pmu_offset, PMU_PCIE_PHY_BYPASS, 0);
+	if (gp->vpcie)
+		regulator_disable(gp->vpcie);
+}
+
+static const struct dw_pcie_host_ops gs201_pcie_host_ops = {
+	.init = gs201_pcie_host_init,
+	.deinit = gs201_pcie_host_deinit,
+};
+
+static bool gs201_pcie_link_up(struct dw_pcie *pci)
+{
+	struct gs201_pcie *gp = to_gs201_pcie(pci);
+	u32 ltssm = readl(gp->pci.elbi_base + ELBI_RDLH_LINKUP) & ELBI_LTSSM_STATE_MASK;
+
+	return ltssm == ELBI_LTSSM_L0;
+}
+
+static int gs201_pcie_start_link(struct dw_pcie *pci)
+{
+	struct gs201_pcie *gp = to_gs201_pcie(pci);
+
+	writel(1, gp->pci.elbi_base + ELBI_APP_LTSSM_ENABLE);
+	return 0;
+}
+
+static void gs201_pcie_stop_link(struct dw_pcie *pci)
+{
+	struct gs201_pcie *gp = to_gs201_pcie(pci);
+
+	writel(0, gp->pci.elbi_base + ELBI_APP_LTSSM_ENABLE);
+}
+
+static const struct dw_pcie_ops gs201_dw_pcie_ops = {
+	.link_up = gs201_pcie_link_up,
+	.start_link = gs201_pcie_start_link,
+	.stop_link = gs201_pcie_stop_link,
+};
+
+
+static int gs201_pcie_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct gs201_pcie *gp;
+	struct dw_pcie *pci;
+	int ret;
+
+	gp = devm_kzalloc(dev, sizeof(*gp), GFP_KERNEL);
+	if (!gp)
+		return -ENOMEM;
+
+	pci = &gp->pci;
+	pci->dev = dev;
+	pci->ops = &gs201_dw_pcie_ops;
+	pci->pp.ops = &gs201_pcie_host_ops;
+
+	gp->phy = devm_platform_ioremap_resource_byname(pdev, "phy");
+	if (IS_ERR(gp->phy))
+		return PTR_ERR(gp->phy);
+	gp->pcs = devm_platform_ioremap_resource_byname(pdev, "pcs");
+	if (IS_ERR(gp->pcs))
+		return PTR_ERR(gp->pcs);
+	gp->udbg = devm_platform_ioremap_resource_byname(pdev, "udbg");
+	if (IS_ERR(gp->udbg))
+		return PTR_ERR(gp->udbg);
+
+	gp->pmu = exynos_get_pmu_regmap_by_phandle(dev->of_node,
+						   "samsung,pmu-syscon");
+	if (IS_ERR(gp->pmu))
+		return dev_err_probe(dev, PTR_ERR(gp->pmu), "no PMU regmap\n");
+	ret = of_property_read_u32_index(dev->of_node, "samsung,pmu-syscon", 1,
+					 &gp->pmu_offset);
+	if (ret)
+		return dev_err_probe(dev, ret, "no PMU PHY control offset\n");
+
+	gp->perst = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(gp->perst))
+		return dev_err_probe(dev, PTR_ERR(gp->perst), "no PERST gpio\n");
+
+	gp->vpcie = devm_regulator_get_optional(dev, "vpcie3v3");
+	if (IS_ERR(gp->vpcie)) {
+		if (PTR_ERR(gp->vpcie) != -ENODEV)
+			return PTR_ERR(gp->vpcie);
+		gp->vpcie = NULL;
+	}
+
+	gp->num_lanes = 1;
+	of_property_read_u32(dev->of_node, "num-lanes", &gp->num_lanes);
+
+	gp->irq = platform_get_irq_byname(pdev, "intr");
+	if (gp->irq < 0)
+		return gp->irq;
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(36));
+	if (ret)
+		return ret;
+
+	platform_set_drvdata(pdev, gp);
+
+	/* MSIs are demultiplexed from the main interrupt, not a chained one */
+	pci->pp.msi_irq[0] = -ENODEV;
+
+	return dw_pcie_host_init(&pci->pp);
+}
+
+static const struct of_device_id gs201_pcie_of_match[] = {
+	{ .compatible = "google,gs201-pcie" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gs201_pcie_of_match);
+
+static struct platform_driver gs201_pcie_driver = {
+	.probe = gs201_pcie_probe,
+	.driver = {
+		.name = "gs201-pcie",
+		.of_match_table = gs201_pcie_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(gs201_pcie_driver);
+
+MODULE_DESCRIPTION("Google gs201 PCIe host controller driver");
+MODULE_LICENSE("GPL");
