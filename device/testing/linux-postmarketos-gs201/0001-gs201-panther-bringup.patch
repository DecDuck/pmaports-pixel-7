diff --git a/drivers/thermal/samsung/acpm_tmu.c b/drivers/thermal/samsung/acpm_tmu.c
new file mode 100644
index 000000000..093ef61b4
--- /dev/null
+++ b/drivers/thermal/samsung/acpm_tmu.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Thermal sensors behind the ACPM firmware (Google Tensor gs201)
+ *
+ * The TMU on gs101/gs201 is owned by the APM; temperatures are read through
+ * the ACPM TMU protocol. This driver polls them and exposes each sensor that
+ * has a DT thermal zone, so the thermal core can apply cooling.
+ */
+
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+#include <linux/units.h>
+
+#define ACPM_TMU_MAX_SENSORS	8
+
+struct acpm_tmu_data {
+	unsigned int acpm_chan_id;
+	unsigned int nr_sensors;
+};
+
+struct acpm_tmu_sensor {
+	struct acpm_tmu *tmu;
+	u8 id;
+};
+
+struct acpm_tmu {
+	struct device *dev;
+	struct acpm_handle *handle;
+	const struct acpm_tmu_data *data;
+	struct acpm_tmu_sensor sensors[ACPM_TMU_MAX_SENSORS];
+};
+
+static int acpm_tmu_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct acpm_tmu_sensor *s = thermal_zone_device_priv(tz);
+	struct acpm_tmu *tmu = s->tmu;
+	int ret, t;
+
+	ret = tmu->handle->ops->tmu.read_temp(tmu->handle,
+					      tmu->data->acpm_chan_id,
+					      s->id, &t);
+	if (ret)
+		return ret;
+
+	*temp = t * MILLIDEGREE_PER_DEGREE;
+
+	return 0;
+}
+
+static const struct thermal_zone_device_ops acpm_tmu_ops = {
+	.get_temp = acpm_tmu_get_temp,
+};
+
+static int acpm_tmu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct thermal_zone_device *tzd;
+	struct acpm_tmu *tmu;
+	unsigned int i, found = 0;
+	int ret;
+
+	tmu = devm_kzalloc(dev, sizeof(*tmu), GFP_KERNEL);
+	if (!tmu)
+		return -ENOMEM;
+
+	tmu->dev = dev;
+	tmu->data = of_device_get_match_data(dev);
+
+	tmu->handle = devm_acpm_get_by_node(dev, dev->parent->of_node);
+	if (IS_ERR(tmu->handle))
+		return dev_err_probe(dev, PTR_ERR(tmu->handle),
+				     "failed to get acpm\n");
+
+	ret = tmu->handle->ops->tmu.init(tmu->handle, tmu->data->acpm_chan_id);
+	if (ret)
+		return dev_err_probe(dev, ret, "TMU init failed\n");
+
+	for (i = 0; i < tmu->data->nr_sensors; i++) {
+		struct acpm_tmu_sensor *s = &tmu->sensors[i];
+
+		s->tmu = tmu;
+		s->id = i;
+
+		tzd = devm_thermal_of_zone_register(dev, i, s, &acpm_tmu_ops);
+		if (IS_ERR(tzd)) {
+			if (PTR_ERR(tzd) == -ENODEV)
+				continue;
+			return dev_err_probe(dev, PTR_ERR(tzd),
+					     "failed to register sensor %u\n", i);
+		}
+		found++;
+	}
+
+	dev_info(dev, "%u thermal zone(s) registered\n", found);
+
+	return 0;
+}
+
+static const struct acpm_tmu_data gs201_acpm_tmu = {
+	.acpm_chan_id = 9,
+	.nr_sensors = 7,
+};
+
+static const struct of_device_id acpm_tmu_of_match[] = {
+	{ .compatible = "google,gs201-acpm-tmu", .data = &gs201_acpm_tmu },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, acpm_tmu_of_match);
+
+static struct platform_driver acpm_tmu_driver = {
+	.driver = {
+		.name = "acpm-tmu",
+		.of_match_table = acpm_tmu_of_match,
+	},
+	.probe = acpm_tmu_probe,
+};
+module_platform_driver(acpm_tmu_driver);
+
+MODULE_DESCRIPTION("ACPM firmware thermal sensor driver");
+MODULE_LICENSE("GPL");
