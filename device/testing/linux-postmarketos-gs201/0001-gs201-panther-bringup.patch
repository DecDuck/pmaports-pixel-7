+		reg = <0x0 0x14520000 0x2000>,
+		      <0x0 0x14560000 0xd000>,
+		      <0x0 0x14550000 0x2000>,
+		      <0x0 0x14540000 0x1000>,
+		      <0x0 0x14800000 0x301000>,
+		      <0x0 0x60ffe000 0x2000>;
+		reg-names = "elbi", "udbg", "phy", "pcs", "dbi", "config";
+		interrupts = <GIC_SPI 428 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "intr";
+		#address-cells = <3>;
+		#size-cells = <2>;
+		device_type = "pci";
+		bus-range = <0x00 0xff>;
+		ranges = <0x82000000 0x0 0x60000000 0x0 0x60000000 0x0 0xff0000>;
+		num-lanes = <2>;
+		max-link-speed = <3>;
+		samsung,pmu-syscon = <&pmu_system_controller 0x3ec4>;
+		status = "disabled";
+	};
+
+	/*
+	 * MMIO peripherals. Pin controller clocks are left to the bootloader
+	 * until a gs201 CMU driver exists (clk_ignore_unused).
