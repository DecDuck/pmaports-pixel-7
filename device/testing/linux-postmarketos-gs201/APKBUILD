maintainer=""
pkgname=linux-postmarketos-gs201
pkgver=7.3_rc6
pkgrel=19
pkgdesc="Google gs201 (Pixel 7 Series) close-to-mainline kernel"
arch="aarch64"
_carch="arm64"
_flavor="postmarketos-gs201"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native pmb:kconfigcheck-community"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	lz4
	openssl-dev
	pahole
	perl
	python3
	zstd
"

# Based on linux-postmarketos-gs101 with a minimal gs201-panther DT on top.
# Source
_commit="e8f42849a581ea8e915ad0f10c25951e696dc6b5"
_config="config-$_flavor.$arch"
source="
	linux-postmarketos-gs101-$_commit.tar.gz::https://gitlab.postmarketos.org/soc/tensor-exynos/linux/-/archive/$_commit/linux-$_commit.tar.gz
	$_config
	0001-gs201-panther-bringup.patch
"
builddir="$srcdir/linux-$_commit"
_outdir=".output"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
}

build() {
	unset LDFLAGS
	make all Image.lz4 ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
		"$pkgdir/boot/linux.efi"

	install -Dm644 "$builddir/arch/$_carch/boot/Image.lz4" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

