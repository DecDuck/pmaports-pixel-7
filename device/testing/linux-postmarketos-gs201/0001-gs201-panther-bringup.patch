diff --git a/drivers/input/touchscreen/focaltech-ft3658.c b/drivers/input/touchscreen/focaltech-ft3658.c
new file mode 100644
index 000000000..c47a56d4c
--- /dev/null
+++ b/drivers/input/touchscreen/focaltech-ft3658.c
@@ -0,0 +1,309 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * FocalTech FT3658 SPI touchscreen driver
+ *
+ * Minimal driver for the FT3658(U) as used on the Google Pixel 7 (panther).
+ * The controller runs firmware from its internal flash; this driver only
+ * resets it and reports the standard FocalTech point data.
+ *
+ * Protocol reference: Google's downstream focaltech_touch ft3658 driver.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+#include <linux/spi/spi.h>
+
+#define FT3658_REG_TOUCH_DATA	0x01
+#define FT3658_REG_CHIP_ID2	0x9f
+#define FT3658_REG_CHIP_ID	0xa3
+#define FT3658_REG_FW_VER	0xa6
+#define FT3658_REG_VENDOR_ID	0xa8
+
+#define FT3658_CHIP_ID		0x56
+#define FT3658_CHIP_ID2		0x52
+
+#define FT3658_CMD_WRITE	0x00
+#define FT3658_CMD_READ		0x80
+#define FT3658_CMD_CRC_EN	0x20
+#define FT3658_HDR_LEN		4
+#define FT3658_DUMMY_LEN	3
+#define FT3658_CRC_LEN		2
+/* status byte (4th byte clocked back): bits 7/5 set means busy/error */
+#define FT3658_STATUS_ERR	0xa0
+#define FT3658_RETRIES		3
+#define FT3658_CS_HIGH_US	150
+
+#define FT3658_MAX_POINTS	10
+#define FT3658_POINT_LEN	6
+/* point count byte + 10 points, as read from FT3658_REG_TOUCH_DATA */
+#define FT3658_DATA_LEN		(2 + FT3658_MAX_POINTS * FT3658_POINT_LEN)
+#define FT3658_BUF_LEN		(FT3658_HDR_LEN + FT3658_DUMMY_LEN + \
+				 FT3658_DATA_LEN + FT3658_CRC_LEN)
+
+#define FT3658_EVENT_DOWN	0
+#define FT3658_EVENT_UP		1
+#define FT3658_EVENT_CONTACT	2
+
+struct ft3658 {
+	struct spi_device *spi;
+	struct input_dev *input;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[2];
+	struct touchscreen_properties prop;
+	struct mutex bus_lock;
+	u8 tx[FT3658_BUF_LEN] ____cacheline_aligned;
+	u8 rx[FT3658_BUF_LEN];
+};
+
+static u16 ft3658_crc(const u8 *data, size_t len)
+{
+	u16 crc = 0xffff;
+	int i;
+
+	while (len--) {
+		crc ^= *data++;
+		for (i = 0; i < 8; i++)
+			crc = (crc & 1) ? (crc >> 1) ^ 0x8408 : crc >> 1;
+	}
+
+	return crc;
+}
+
+static int ft3658_read(struct ft3658 *ts, u8 reg, u8 *data, size_t len)
+{
+	size_t dp = FT3658_HDR_LEN + FT3658_DUMMY_LEN;
+	size_t xlen = dp + len + FT3658_CRC_LEN;
+	struct spi_transfer xfer = {
+		.tx_buf = ts->tx,
+		.rx_buf = ts->rx,
+		.len = xlen,
+	};
+	u16 crc;
+	int ret = -EIO, i;
+
+	if (xlen > FT3658_BUF_LEN)
+		return -EINVAL;
+
+	mutex_lock(&ts->bus_lock);
+	for (i = 0; i < FT3658_RETRIES; i++) {
+		memset(ts->tx, 0, xlen);
+		ts->tx[0] = reg;
+		ts->tx[1] = FT3658_CMD_READ | FT3658_CMD_CRC_EN;
+		ts->tx[2] = len >> 8;
+		ts->tx[3] = len & 0xff;
+
+		ret = spi_sync_transfer(ts->spi, &xfer, 1);
+		udelay(FT3658_CS_HIGH_US);
+		if (ret)
+			continue;
+
+		if (ts->rx[3] & FT3658_STATUS_ERR) {
+			ret = -EIO;
+			continue;
+		}
+
+		crc = ts->rx[dp + len] | (ts->rx[dp + len + 1] << 8);
+		if (ft3658_crc(&ts->rx[dp], len) != crc) {
+			ret = -EBADMSG;
+			continue;
+		}
+
+		memcpy(data, &ts->rx[dp], len);
+		ret = 0;
+		break;
+	}
+	mutex_unlock(&ts->bus_lock);
+
+	if (ret)
+		dev_dbg(&ts->spi->dev, "read 0x%02x failed (%d), status 0x%02x\n",
+			reg, ret, ts->rx[3]);
+
+	return ret;
+}
+
+static int ft3658_read_reg(struct ft3658 *ts, u8 reg, u8 *val)
+{
+	return ft3658_read(ts, reg, val, 1);
+}
+
+static void ft3658_reset(struct ft3658 *ts)
+{
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ts->reset_gpio, 0);
+	msleep(200);
+}
+
+static irqreturn_t ft3658_irq(int irq, void *dev_id)
+{
+	struct ft3658 *ts = dev_id;
+	u8 buf[FT3658_DATA_LEN];
+	int i, ret;
+
+	ret = ft3658_read(ts, FT3658_REG_TOUCH_DATA, buf, sizeof(buf));
+	if (ret)
+		return IRQ_HANDLED;
+
+	/* buf[1] = number of points; then FT3658_POINT_LEN bytes per point */
+	for (i = 0; i < FT3658_MAX_POINTS; i++) {
+		u8 *p = &buf[2 + i * FT3658_POINT_LEN];
+		unsigned int id = p[2] >> 4;
+		unsigned int event = p[0] >> 6;
+		unsigned int x, y, major;
+		bool down;
+
+		if (id >= FT3658_MAX_POINTS)
+			break;
+
+		x = ((p[0] & 0x0f) << 8) | p[1];
+		y = ((p[2] & 0x0f) << 8) | p[3];
+		major = (p[5] >> 1) & 0x7f;
+		down = event == FT3658_EVENT_DOWN || event == FT3658_EVENT_CONTACT;
+
+		input_mt_slot(ts->input, id);
+		if (!input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, down))
+			continue;
+
+		touchscreen_report_pos(ts->input, &ts->prop, x, y, true);
+		if (major)
+			input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, major);
+	}
+
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+
+	return IRQ_HANDLED;
+}
+
+static void ft3658_power_off(void *data)
+{
+	struct ft3658 *ts = data;
+
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ts->supplies), ts->supplies);
+}
+
+static int ft3658_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct ft3658 *ts;
+	u8 id, id2, fw = 0, vendor = 0;
+	int ret;
+
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+
+	ts->spi = spi;
+	mutex_init(&ts->bus_lock);
+	spi_set_drvdata(spi, ts);
+
+	spi->mode = SPI_MODE_0;
+	spi->bits_per_word = 8;
+	if (!spi->max_speed_hz)
+		spi->max_speed_hz = 10000000;
+	ret = spi_setup(spi);
+	if (ret)
+		return ret;
+
+	ts->supplies[0].supply = "vdd";
+	ts->supplies[1].supply = "avdd";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ts->supplies),
+				      ts->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	ts->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ts->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ts->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ts->supplies), ts->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable supplies\n");
+
+	ret = devm_add_action_or_reset(dev, ft3658_power_off, ts);
+	if (ret)
+		return ret;
+
+	usleep_range(1000, 2000);
+	ft3658_reset(ts);
+
+	ret = ft3658_read_reg(ts, FT3658_REG_CHIP_ID, &id);
+	if (!ret)
+		ret = ft3658_read_reg(ts, FT3658_REG_CHIP_ID2, &id2);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to read chip id (status 0x%02x, raw %*ph)\n",
+				     ts->rx[3], 12, ts->rx);
+
+	ft3658_read_reg(ts, FT3658_REG_FW_VER, &fw);
+	ft3658_read_reg(ts, FT3658_REG_VENDOR_ID, &vendor);
+	dev_info(dev, "chip id %02x%02x, firmware 0x%02x, vendor 0x%02x\n",
+		 id, id2, fw, vendor);
+
+	if (id != FT3658_CHIP_ID || id2 != FT3658_CHIP_ID2)
+		return dev_err_probe(dev, -ENODEV,
+				     "unexpected chip id (firmware not running?)\n");
+
+	ts->input = devm_input_allocate_device(dev);
+	if (!ts->input)
+		return -ENOMEM;
+
+	ts->input->name = "FocalTech FT3658 Touchscreen";
+	ts->input->id.bustype = BUS_SPI;
+
+	input_set_capability(ts->input, EV_ABS, ABS_MT_POSITION_X);
+	input_set_capability(ts->input, EV_ABS, ABS_MT_POSITION_Y);
+	input_set_abs_params(ts->input, ABS_MT_TOUCH_MAJOR, 0, 0x7f, 0, 0);
+	touchscreen_parse_properties(ts->input, true, &ts->prop);
+
+	ret = input_mt_init_slots(ts->input, FT3658_MAX_POINTS,
+				  INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return ret;
+
+	ret = input_register_device(ts->input);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, spi->irq, NULL, ft3658_irq,
+					IRQF_ONESHOT, "ft3658", ts);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request irq\n");
+
+	return 0;
+}
+
+static const struct of_device_id ft3658_of_match[] = {
+	{ .compatible = "focaltech,ft3658" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ft3658_of_match);
+
+static const struct spi_device_id ft3658_spi_ids[] = {
+	{ "ft3658" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, ft3658_spi_ids);
+
+static struct spi_driver ft3658_driver = {
+	.driver = {
+		.name = "ft3658",
+		.of_match_table = ft3658_of_match,
+	},
+	.id_table = ft3658_spi_ids,
+	.probe = ft3658_probe,
+};
+module_spi_driver(ft3658_driver);
+
+MODULE_DESCRIPTION("FocalTech FT3658 SPI touchscreen driver");
+MODULE_LICENSE("GPL");
