-int btbcm_patchram(struct hci_dev *hdev, const struct firmware *fw)
+/* Send a command without waiting for (or expecting) a completion event */
+static int btbcm_send_raw_cmd(struct hci_dev *hdev, u16 opcode, u8 plen,
+			      const void *param)
+{
+	struct hci_command_hdr *hdr;
+	struct sk_buff *skb;
+
+	skb = bt_skb_alloc(HCI_COMMAND_HDR_SIZE + plen, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+
+	hdr = skb_put(skb, HCI_COMMAND_HDR_SIZE);
+	hdr->opcode = cpu_to_le16(opcode);
+	hdr->plen = plen;
+	skb_put_data(skb, param, plen);
+	hci_skb_pkt_type(skb) = HCI_COMMAND_PKT;
+
+	return hdev->send(hdev, skb);
+}
+
+static int __btbcm_patchram(struct hci_dev *hdev, const struct firmware *fw,
+			    bool stream)
 {
 	const struct hci_command_hdr *cmd;
 	const u8 *fw_ptr;
@@ -251,6 +272,21 @@ int btbcm_patchram(struct hci_dev *hdev, const struct firmware *fw)
 
 		opcode = le16_to_cpu(cmd->opcode);
 
+		/*
+		 * Some controllers' minidrivers never acknowledge Write RAM
+		 * commands, so the patch has to be streamed until Launch RAM.
+		 */
+		if (stream && opcode == 0xfc4c) {
+			err = btbcm_send_raw_cmd(hdev, opcode, cmd->plen,
+						 cmd_param);
+			if (err) {
+				bt_dev_err(hdev, "BCM: Patch write failed (%d)",
+					   err);
+				return err;
+			}
+			continue;
+		}
+
 		skb = __hci_cmd_sync(hdev, opcode, cmd->plen, cmd_param,
 				     HCI_INIT_TIMEOUT);
 		if (IS_ERR(skb)) {
@@ -267,6 +303,11 @@ int btbcm_patchram(struct hci_dev *hdev, const struct firmware *fw)
 
 	return 0;
 }
+
+int btbcm_patchram(struct hci_dev *hdev, const struct firmware *fw)
+{
+	return __btbcm_patchram(hdev, fw, false);
+}
 EXPORT_SYMBOL(btbcm_patchram);
 
