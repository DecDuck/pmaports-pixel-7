new file mode 100644
index 000000000..87928597a
--- /dev/null
+++ b/drivers/soc/samsung/gs201-fb-refresh.c
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * gs201 bring-up aid: put the bootloader-initialised DECON0 into continuous
+ * refresh so the simple-framebuffer console is visible from early boot,
+ * including panics. Same write the initramfs display hook does.
+ */
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/of.h>
+
+#define GS201_DECON0_TRIG_CON	0x1c240030
+#define GS201_DECON0_TRIG_VAL	0x3061
+
+static int __init gs201_fb_refresh_init(void)
+{
+	void __iomem *reg;
+
+	if (!of_machine_is_compatible("google,gs201"))
+		return 0;
+
+	reg = ioremap(GS201_DECON0_TRIG_CON, 4);
+	if (!reg)
+		return -ENOMEM;
+	writel(GS201_DECON0_TRIG_VAL, reg);
+	iounmap(reg);
+	return 0;
+}
+early_initcall(gs201_fb_refresh_init);
