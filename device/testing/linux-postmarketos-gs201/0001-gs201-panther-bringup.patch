@@ -0,0 +1,465 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PCIe host controller driver for Google gs201 (Tensor G2) SoC.
+ *
+ * Samsung glue around a Synopsys DesignWare PCIe Gen4 core with a Samsung
+ * PCIe PHY. The PHY/PCS programming and link-up sequence follow Google's
+ * downstream driver (pcie-exynos-rc.c, pcie-exynos-gs201-rc-cal.c).
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/iopoll.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pci.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/soc/samsung/exynos-pmu.h>
+
+#include "pcie-designware.h"
+
+/* ELBI (PCIe sub-controller) registers */
+#define ELBI_IRQ0			0x000
+#define ELBI_IRQ1			0x004
+#define ELBI_IRQ2			0x008
+#define ELBI_IRQ0_EN			0x010
+#define ELBI_IRQ0_INTX_MASK		(BIT(14) | BIT(16) | BIT(18) | BIT(20))
+#define ELBI_IRQ1_EN			0x014
+#define ELBI_IRQ2_EN			0x018
+#define ELBI_IRQ2_MSI			BIT(17)
+#define ELBI_APP_LTSSM_ENABLE		0x054
+#define ELBI_APP_REQ_EXIT_L1		0x06c
+#define ELBI_APP_XFER_PENDING		0x074
+#define ELBI_RDLH_LINKUP		0x2c8
+#define ELBI_LTSSM_STATE_MASK		GENMASK(5, 0)
+#define ELBI_LTSSM_L0			0x11
+#define ELBI_LINKDOWN_RST_CTRL_SEL	0x3a0
+#define ELBI_LINKDOWN_RST_MANUAL	BIT(1)
+#define ELBI_QCH_SEL			0x3a8
+#define ELBI_QCH_CLOCK_GATING_MASK	GENMASK(11, 0)
+#define ELBI_APP_REQ_EXIT_L1_MODE	0x3bc
+#define ELBI_APP_REQ_EXIT_L1_MODE_SW	BIT(0)
+#define ELBI_L1_REQ_NAK_CONTROL_MASTER	BIT(4)
+#define ELBI_MSTR_PEND_SEL_NAK		0x474
+#define ELBI_DBI_L1_EXIT_DISABLE	0x1078
+#define ELBI_PHY_PORT_RST		0x1400
+#define ELBI_PHY_CMN_RST		0x1404
+#define ELBI_PHY_INIT_RST		0x1408
+
+/* PMU PHY control: bit 0 releases PHY isolation */
+#define PMU_PCIE_PHY_BYPASS		BIT(0)
+#define PMU_PCIE_PHY_EXTRA		BIT(10)
+
+/* DWC port logic registers used by the vendor setup */
+#define PCIE_GEN3_RELATED_OFF_EQ	0x890
+#define PCIE_AUX_CLK_FREQ_OFF		0xb40
+#define PCIE_AUX_CLK_FREQ_26MHZ		0x1a
+#define PCIE_L1_SUBSTATES_OFF		0xb44
+#define PCIE_L1_SUB_VAL			0xea
+
+struct gs201_pcie {
+	struct dw_pcie pci;
+	void __iomem *phy;
+	void __iomem *pcs;
+	void __iomem *udbg;
+	struct regmap *pmu;
+	u32 pmu_offset;
+	struct gpio_desc *perst;
+	struct regulator *vpcie;
+	int num_lanes;
+	int irq;
+	bool irq_requested;
+};
+
+#define to_gs201_pcie(x) container_of(x, struct gs201_pcie, pci)
+
+/* "elbi" is mapped by the DWC core (dw_pcie_get_resources) */
+
+static void gs201_pcie_phy_pwrdn_clear(struct gs201_pcie *gp)
+{
+	static const u32 regs[] = {
+		0x408, 0x40c, 0x800, 0x804, 0xa40, 0xa44, 0xa48, 0xa4c, 0xa50,
+		0x1000, 0x1004, 0x1240, 0x1244, 0x1248, 0x124c, 0x1250,
+	};
+	int i;
+
+	writel(0x28, gp->phy + 0xd8);
+	mdelay(1);
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		writel(0, gp->phy + regs[i]);
+}
+
+struct gs201_reg_val {
+	u16 reg;
+	u8 val;
+};
+
