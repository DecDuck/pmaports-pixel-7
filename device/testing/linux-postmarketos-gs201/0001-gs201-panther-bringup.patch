+	/*
+	 * 24.576 MHz, as on gs101. Downstream CAL lists FIXEDRATE OSCCLK_* as
+	 * 26 MHz, but its own PLL rate tables (e.g. shared0 2133 MHz at
+	 * M=347 P=4 S=0) and the arch timer imply 24.576 MHz.
+	 */
+	oscclk: clock-oscclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24576000>;
+		clock-output-names = "oscclk";
+	};
+
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+	};
+
+	reserved_memory: reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		gsa@90200000 {
+			reg = <0x0 0x90200000 0x400000>;
+			no-map;
+		};
+
+		tpu-fw@93000000 {
+			reg = <0x0 0x93000000 0x1000000>;
+			no-map;
+		};
+
+		aoc@94000000 {
+			reg = <0x0 0x94000000 0x3000000>;
+			no-map;
+		};
+
+		abl@f8800000 {
+			reg = <0x0 0xf8800000 0x2000000>;
+			no-map;
+		};
+
+		dss-log@fd3f0000 {
+			reg = <0x0 0xfd3f0000 0xe000>;
+			no-map;
+		};
+
+		debug-kinfo@fd3fe000 {
+			reg = <0x0 0xfd3fe000 0x1000>;
+			no-map;
+		};
