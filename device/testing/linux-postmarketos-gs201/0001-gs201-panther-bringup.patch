+	memmap.fw.end = cpu_to_le32(fw_end);
+	memmap.heap.start = cpu_to_le32(heap_start);
+	memmap.heap.end = cpu_to_le32(heap_end);
+
+	brcmf_pcie_tcm_toio(devinfo, sig_start, fwsig->data, fwsig->size);
+	brcmf_pcie_tcm_memset(devinfo, vstatus_start, 0, BRCMF_VSTATUS_SIZE);
+	brcmf_pcie_tcm_toio(devinfo, *address, &memmap, sizeof(memmap));
+
+	err = brcmf_pcie_alloc_rtlv(devinfo, address, BRCMF_END_MAGIC, 0);
+	if (err)
+		return err;
+
+	devinfo->skip_reset_vector = true;
+	return 0;
+}
