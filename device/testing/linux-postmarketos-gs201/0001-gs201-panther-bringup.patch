diff --git a/drivers/irqchip/irq-gs201-vgpio2ap.c b/drivers/irqchip/irq-gs201-vgpio2ap.c
new file mode 100644
index 000000000..d6c829141
--- /dev/null
+++ b/drivers/irqchip/irq-gs201-vgpio2ap.c
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Google gs201 INTCOMB_VGPIO2AP interrupt combiner.
+ *
+ * Virtual GPIOs carried over I3C IBIs from the PMICs are latched in the
+ * combiner's pending register and signalled to the GIC on a single SPI.
+ * Pending bits are cleared by writing 1, but re-latch for as long as the
+ * source stays asserted. The source only drops once the consumer has read
+ * the PMIC over ACPM in its threaded handler, so the parent SPI is masked
+ * while any child is masked to avoid an interrupt storm.
+ *
+ * Once CPUs power down in idle, the PMU wakes them; it only does so for
+ * these interrupts if VGPIO2PMU_EINT is enabled in WAKEUP2_INT_EN.
+ */
+
+#include <linux/bits.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/irqchip.h>
+#include <linux/irqchip/chained_irq.h>
+#include <linux/irqdomain.h>
+#include <linux/of_address.h>
+#include <linux/mutex.h>
+#include <linux/of_irq.h>
+#include <linux/regmap.h>
+#include <linux/soc/samsung/exynos-pmu.h>
+#include <linux/soc/samsung/exynos-regs-pmu.h>
+#include <linux/spinlock.h>
+
+#define VGPIO2AP_INTC_IPEND	0x290
+#define VGPIO2AP_NR_IRQS	32
+#define WAKEUP2_VGPIO2PMU_EINT	BIT(13)
+
+struct vgpio2ap {
+	void __iomem *base;
+	struct irq_domain *domain;
+	struct irq_data *parent;
+	raw_spinlock_t lock;
+	unsigned long masked;
+	bool parent_masked;
+	/* wake state, protected by wake_lock (genirq bus lock) */
+	struct mutex wake_lock;
+	unsigned long wake;
+	bool wake_applied;
+};
+
+static void vgpio2ap_irq_ack(struct irq_data *d)
+{
+	struct vgpio2ap *vg = irq_data_get_irq_chip_data(d);
+
+	writel(BIT(irqd_to_hwirq(d)), vg->base + VGPIO2AP_INTC_IPEND);
+}
+
+/* Source enables are configured by the bootloader; mask in software */
+static void vgpio2ap_irq_mask(struct irq_data *d)
+{
+	struct vgpio2ap *vg = irq_data_get_irq_chip_data(d);
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&vg->lock, flags);
+	__set_bit(irqd_to_hwirq(d), &vg->masked);
+	raw_spin_unlock_irqrestore(&vg->lock, flags);
+}
+
+static void vgpio2ap_irq_unmask(struct irq_data *d)
+{
+	struct vgpio2ap *vg = irq_data_get_irq_chip_data(d);
+	struct irq_chip *pchip = irq_data_get_irq_chip(vg->parent);
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&vg->lock, flags);
+	__clear_bit(irqd_to_hwirq(d), &vg->masked);
+	/* Drop the bit latched while masked; it re-latches if still asserted */
+	writel(BIT(irqd_to_hwirq(d)), vg->base + VGPIO2AP_INTC_IPEND);
+	if (vg->parent_masked) {
+		vg->parent_masked = false;
+		pchip->irq_unmask(vg->parent);
+	}
+	raw_spin_unlock_irqrestore(&vg->lock, flags);
+}
+
+static int vgpio2ap_irq_set_wake(struct irq_data *d, unsigned int on)
+{
+	struct vgpio2ap *vg = irq_data_get_irq_chip_data(d);
+
+	if (on)
+		__set_bit(irqd_to_hwirq(d), &vg->wake);
+	else
+		__clear_bit(irqd_to_hwirq(d), &vg->wake);
+
+	return 0;
+}
+
+static void vgpio2ap_irq_bus_lock(struct irq_data *d)
+{
+	struct vgpio2ap *vg = irq_data_get_irq_chip_data(d);
+
+	mutex_lock(&vg->wake_lock);
+}
+
+static void vgpio2ap_irq_bus_sync_unlock(struct irq_data *d)
+{
+	struct vgpio2ap *vg = irq_data_get_irq_chip_data(d);
+	bool want = vg->wake;
+	struct regmap *pmu;
+	int ret;
+
+	if (want != vg->wake_applied) {
+		pmu = exynos_get_pmu_regmap();
+		if (IS_ERR(pmu)) {
+			ret = PTR_ERR(pmu);
+		} else {
+			ret = regmap_update_bits(pmu, GS101_WAKEUP2_INT_EN,
+						 WAKEUP2_VGPIO2PMU_EINT,
+						 want ? WAKEUP2_VGPIO2PMU_EINT : 0);
+		}
+		if (ret)
+			pr_warn_ratelimited("vgpio2ap: failed to %s PMU wakeup: %d\n",
+					    want ? "enable" : "disable", ret);
+		else
+			vg->wake_applied = want;
+	}
+
+	mutex_unlock(&vg->wake_lock);
+}
+
+static struct irq_chip vgpio2ap_chip = {
+	.name			= "vgpio2ap",
+	.irq_ack		= vgpio2ap_irq_ack,
+	.irq_mask		= vgpio2ap_irq_mask,
+	.irq_unmask		= vgpio2ap_irq_unmask,
+	.irq_set_wake		= vgpio2ap_irq_set_wake,
+	.irq_bus_lock		= vgpio2ap_irq_bus_lock,
+	.irq_bus_sync_unlock	= vgpio2ap_irq_bus_sync_unlock,
+};
+
+static void vgpio2ap_irq_handler(struct irq_desc *desc)
+{
+	struct vgpio2ap *vg = irq_desc_get_handler_data(desc);
+	struct irq_chip *chip = irq_desc_get_chip(desc);
+	unsigned long pending, handled = 0;
+	unsigned int bit, virq;
+
+	chained_irq_enter(chip, desc);
+
+	pending = readl(vg->base + VGPIO2AP_INTC_IPEND);
+	for_each_set_bit(bit, &pending, VGPIO2AP_NR_IRQS) {
+		virq = irq_find_mapping(vg->domain, bit);
+		if (!virq || !irq_has_action(virq)) {
+			/* Nothing will ever ack or unmask this one */
+			writel(BIT(bit), vg->base + VGPIO2AP_INTC_IPEND);
+			continue;
+		}
+		generic_handle_irq(virq);
+		handled |= BIT(bit);
+	}
+
+	/* Keep the SPI quiet until the masked child's handler is done */
+	raw_spin_lock(&vg->lock);
+	if (vg->masked & handled && !vg->parent_masked) {
+		vg->parent_masked = true;
+		chip->irq_mask(&desc->irq_data);
+	}
+	raw_spin_unlock(&vg->lock);
+
+	chained_irq_exit(chip, desc);
+}
+
+static int vgpio2ap_irq_map(struct irq_domain *d, unsigned int virq,
+			    irq_hw_number_t hw)
+{
+	irq_set_chip_data(virq, d->host_data);
+	irq_set_chip_and_handler(virq, &vgpio2ap_chip, handle_level_irq);
+	irq_set_noprobe(virq);
+
+	return 0;
+}
+
+static const struct irq_domain_ops vgpio2ap_domain_ops = {
+	.map	= vgpio2ap_irq_map,
+	.xlate	= irq_domain_xlate_twocell,
+};
+
+static int __init vgpio2ap_of_init(struct device_node *np,
+				   struct device_node *parent)
+{
+	struct vgpio2ap *vg;
+	int irq, ret;
+
+	vg = kzalloc(sizeof(*vg), GFP_KERNEL);
+	if (!vg)
+		return -ENOMEM;
+
+	vg->base = of_iomap(np, 0);
+	if (!vg->base) {
+		ret = -ENOMEM;
+		goto err_free;
+	}
+
+	irq = irq_of_parse_and_map(np, 0);
+	if (!irq) {
+		ret = -EINVAL;
+		goto err_unmap;
+	}
+
+	vg->domain = irq_domain_create_linear(of_fwnode_handle(np),
+					      VGPIO2AP_NR_IRQS,
+					      &vgpio2ap_domain_ops, vg);
+	if (!vg->domain) {
+		ret = -ENOMEM;
+		goto err_unmap;
+	}
+
+	raw_spin_lock_init(&vg->lock);
+	mutex_init(&vg->wake_lock);
+	vg->masked = ~0UL;
+	vg->parent = irq_get_irq_data(irq);
+
+	/* Drop anything latched before Linux took over */
+	writel(GENMASK(VGPIO2AP_NR_IRQS - 1, 0), vg->base + VGPIO2AP_INTC_IPEND);
+
+	irq_set_chained_handler_and_data(irq, vgpio2ap_irq_handler, vg);
+
+	return 0;
+
+err_unmap:
+	iounmap(vg->base);
+err_free:
+	kfree(vg);
+	return ret;
+}
+IRQCHIP_DECLARE(gs201_vgpio2ap, "google,gs201-vgpio2ap", vgpio2ap_of_init);
