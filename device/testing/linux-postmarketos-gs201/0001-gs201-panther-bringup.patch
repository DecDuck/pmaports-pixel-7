+	S2MPG12_REG("ldo21m", S2MPG12_LDO21, 1800000, 25000, 64, 0x40, 0x40, BIT(7), S2MPG12_ENABLE_TIME_LDO),
+	S2MPG12_REG("ldo22m", S2MPG12_LDO22, 300000, 12500, 128, 0x41, 0x49, GENMASK(7, 6), S2MPG12_ENABLE_TIME_LDO),
+	S2MPG12_REG("ldo23m", S2MPG12_LDO23, 700000, 25000, 64, 0x42, 0x42, GENMASK(7, 6), S2MPG12_ENABLE_TIME_LDO),
+	S2MPG12_REG("ldo24m", S2MPG12_LDO24, 700000, 25000, 64, 0x43, 0x43, BIT(7), S2MPG12_ENABLE_TIME_LDO),
+	S2MPG12_REG("ldo25m", S2MPG12_LDO25, 700000, 25000, 64, 0x44, 0x44, BIT(7), S2MPG12_ENABLE_TIME_LDO),
+	S2MPG12_REG("ldo26m", S2MPG12_LDO26, 1800000, 25000, 64, 0x45, 0x45, GENMASK(7, 6), S2MPG12_ENABLE_TIME_LDO),
+	S2MPG12_REG("ldo27m", S2MPG12_LDO27, 1800000, 25000, 64, 0x46, 0x46, BIT(7), S2MPG12_ENABLE_TIME_LDO),
+	S2MPG12_REG("ldo28m", S2MPG12_LDO28, 725000, 12500, 64, 0x47, 0x47, BIT(7), S2MPG12_ENABLE_TIME_LDO),
+	S2MPG12_REG("buck1m", S2MPG12_BUCK1, 200000, 6250, 256, 0x18, 0x17, GENMASK(7, 6), S2MPG12_ENABLE_TIME_BUCK),
+	S2MPG12_REG("buck2m", S2MPG12_BUCK2, 200000, 6250, 256, 0x1a, 0x19, GENMASK(7, 6), S2MPG12_ENABLE_TIME_BUCK),
+	S2MPG12_REG("buck3m", S2MPG12_BUCK3, 200000, 6250, 256, 0x1c, 0x1b, GENMASK(7, 6), S2MPG12_ENABLE_TIME_BUCK),
+	S2MPG12_REG("buck4m", S2MPG12_BUCK4, 200000, 6250, 256, 0x1e, 0x1d, GENMASK(7, 6), S2MPG12_ENABLE_TIME_BUCK),
+	S2MPG12_REG("buck5m", S2MPG12_BUCK5, 200000, 6250, 256, 0x20, 0x1f, GENMASK(7, 6), S2MPG12_ENABLE_TIME_BUCK),
+	S2MPG12_REG("buck6m", S2MPG12_BUCK6, 200000, 6250, 256, 0x22, 0x21, GENMASK(7, 6), S2MPG12_ENABLE_TIME_BUCK),
+	S2MPG12_REG("buck7m", S2MPG12_BUCK7, 200000, 6250, 256, 0x24, 0x23, GENMASK(7, 6), S2MPG12_ENABLE_TIME_BUCK),
+	S2MPG12_REG("buck8m", S2MPG12_BUCK8, 200000, 6250, 256, 0x26, 0x25, BIT(7), S2MPG12_ENABLE_TIME_BUCK),
+	S2MPG12_REG("buck9m", S2MPG12_BUCK9, 200000, 6250, 256, 0x28, 0x27, GENMASK(7, 6), S2MPG12_ENABLE_TIME_BUCK),
+	S2MPG12_REG("buck10m", S2MPG12_BUCK10, 200000, 6250, 256, 0x2a, 0x29, GENMASK(7, 6), S2MPG12_ENABLE_TIME_BUCK),
+};
+
+static int s2mpg12_regulator_probe(struct platform_device *pdev)
+{
+	struct sec_pmic_dev *iodev = dev_get_drvdata(pdev->dev.parent);
+	struct regulator_config config = { };
+	unsigned int i;
+
+	device_set_of_node_from_dev(&pdev->dev, pdev->dev.parent);
+
+	config.dev = &pdev->dev;
+	config.regmap = iodev->regmap_pmic;
+
+	for (i = 0; i < ARRAY_SIZE(s2mpg12_regulators); i++) {
+		struct regulator_dev *rdev;
+
+		rdev = devm_regulator_register(&pdev->dev,
+					       &s2mpg12_regulators[i], &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(&pdev->dev, PTR_ERR(rdev),
+					     "failed to register %s\n",
+					     s2mpg12_regulators[i].name);
+	}
+
+	return 0;
+}
+
+static const struct platform_device_id s2mpg12_regulator_id[] = {
+	{ "s2mpg12-regulator" },
+	{ }
+};
+MODULE_DEVICE_TABLE(platform, s2mpg12_regulator_id);
+
+static struct platform_driver s2mpg12_regulator_driver = {
+	.driver = {
+		.name = "s2mpg12-regulator",
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+	},
+	.probe = s2mpg12_regulator_probe,
+	.id_table = s2mpg12_regulator_id,
+};
+module_platform_driver(s2mpg12_regulator_driver);
+
+MODULE_DESCRIPTION("Samsung S2MPG12 regulator driver");
+MODULE_LICENSE("GPL");
