# Reference: <https://nura.eco/devicepkg>
maintainer=""
pkgname=device-google-panther
pkgver=1
pkgrel=18
pkgdesc="Google Pixel 7"
url="https://nura.eco"
arch="aarch64"
license="MIT"
depends="
	android-tools
	device-mapper
	linux-firmware-arm
	linux-postmarketos-gs201
	postmarketos-base
	python3
	soc-google-gs201
	"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	disable-suspend.conf
	panther-extract-firmware
	panther-extract-firmware.service
	panther-extract-firmware.initd
	80-device-google-panther.preset
	"
install="
	$pkgname-openrc.post-install
	$pkgname-openrc.post-upgrade
	"
subpackages="$pkgname-openrc"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/disable-suspend.conf \
		"$pkgdir"/usr/lib/systemd/sleep.conf.d/50-panther-disable-suspend.conf
	install -Dm644 "$srcdir"/disable-suspend.conf \
		"$pkgdir"/usr/lib/elogind/sleep.conf.d/50-panther-disable-suspend.conf

	# Bluetooth firmware can't be redistributed; copy it from Android
	install -Dm755 "$srcdir"/panther-extract-firmware \
		-t "$pkgdir"/usr/libexec/
	install -Dm644 "$srcdir"/panther-extract-firmware.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/80-device-google-panther.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
	install -Dm755 "$srcdir"/panther-extract-firmware.initd \
		"$pkgdir"/etc/init.d/panther-extract-firmware
}

openrc() {
	default_openrc
}
