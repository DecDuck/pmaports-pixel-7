+/*
+ * Firmware advertising "host_sfhllc" (e.g. BCM4389) expects the host to send
+ * 802.3 frames with an LLC/SNAP header instead of Ethernet II frames.
+ * Returns true if the frame was converted.
+ */
+static bool brcmf_msgbuf_tx_to_8023(struct sk_buff *skb)
+{
+	struct ethhdr eh;
+	u16 type;
+	u8 *p;
+
+	if (skb->len < ETH_HLEN)
+		return false;
+	memcpy(&eh, skb->data, ETH_HLEN);
+	type = ntohs(eh.h_proto);
+	if (type < ETH_P_802_3_MIN)
+		return false;
+	if (skb_cow_head(skb, BRCMF_LLC_SNAP_HDR_LEN))
+		return false;
+
+	p = skb_push(skb, BRCMF_LLC_SNAP_HDR_LEN);
+	memcpy(p, eh.h_dest, ETH_ALEN);
+	memcpy(p + ETH_ALEN, eh.h_source, ETH_ALEN);
+	put_unaligned_be16(skb->len - ETH_HLEN, p + 12);
+	p[14] = 0xaa;
+	p[15] = 0xaa;
+	p[16] = 0x03;
+	p[17] = 0x00;
+	p[18] = 0x00;
+	/* 802.1H bridge tunnel for IPX and AppleTalk AARP */
+	p[19] = (type == ETH_P_IPX || type == ETH_P_AARP) ? 0xf8 : 0x00;
+	put_unaligned_be16(type, p + 20);
+	return true;
+}
+
+static void brcmf_msgbuf_tx_from_8023(struct sk_buff *skb)
+{
+	u8 addrs[2 * ETH_ALEN];
+	u8 *p = skb->data;
+	u16 type;
+
+	if (skb->len < ETH_HLEN + BRCMF_LLC_SNAP_HDR_LEN ||
+	    get_unaligned_be16(p + 12) >= ETH_P_802_3_MIN ||
+	    p[14] != 0xaa || p[15] != 0xaa || p[16] != 0x03)
+		return;
+
+	memcpy(addrs, p, sizeof(addrs));
+	type = get_unaligned_be16(p + 20);
+	p = skb_pull(skb, BRCMF_LLC_SNAP_HDR_LEN);
+	memcpy(p, addrs, sizeof(addrs));
+	put_unaligned_be16(type, p + 12);
+}
