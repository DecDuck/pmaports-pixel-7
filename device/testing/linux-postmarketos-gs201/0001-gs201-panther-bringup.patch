+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Google GS201 (Tensor G2) SoC - minimal mainline description.
+ *
+ * Addresses, interrupts and register data are taken from Google's downstream
+ * gs201 sources (kernel/devices/google/gs201 and kernel/google-modules/soc/gs,
+ * android-gs-pantah-6.1-android16). DRAM (/memory) is filled in by the
+ * bootloader.
+ *
+ * NOTE: the Android 16 bootloader takes the DTB from vendor_kernel_boot, not
+ * vendor_boot, and unpacks init_boot's ramdisk last; flash both accordingly.
+ */
+
+#include <dt-bindings/clock/google,gs101-acpm.h>
+#include <dt-bindings/clock/google,gs201.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/soc/samsung,exynos-usi.h>
+#include <dt-bindings/thermal/thermal.h>
+#include "gs101-pinctrl.h"
+
+/ {
+	compatible = "google,gs201";
+	#address-cells = <2>;
+	#size-cells = <1>;
+	interrupt-parent = <&gic>;
+
+	aliases {
+		/* in range of SERIAL_SAMSUNG_UARTS and off the ttySAC0 console */
+		serial1 = &serial_18;
+		pinctrl0 = &pinctrl_gpio_alive;
+		pinctrl1 = &pinctrl_far_alive;
+		pinctrl2 = &pinctrl_gsacore;
+		pinctrl3 = &pinctrl_gsactrl;
+		pinctrl4 = &pinctrl_peric0;
+		pinctrl5 = &pinctrl_peric1;
+		pinctrl6 = &pinctrl_hsi1;
+		pinctrl7 = &pinctrl_hsi2;
+		pinctrl8 = &pinctrl_hsi2ufs;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu-map {
+			cluster0 {
+				core0 { cpu = <&cpu0>; };
+				core1 { cpu = <&cpu1>; };
+				core2 { cpu = <&cpu2>; };
+				core3 { cpu = <&cpu3>; };
+			};
+
+			cluster1 {
+				core0 { cpu = <&cpu4>; };
+				core1 { cpu = <&cpu5>; };
+			};
+
+			cluster2 {
+				core0 { cpu = <&cpu6>; };
+				core1 { cpu = <&cpu7>; };
+			};
+		};
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x0000>;
+			clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_CPUCL0>;
+			enable-method = "psci";
+			#cooling-cells = <2>;
+			operating-points-v2 = <&cpucl0_opp_table>;
+			capacity-dmips-mhz = <250>;
+			cpu-idle-states = <&ananke_cpu_sleep>;
+		};
+
+		cpu1: cpu@100 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x0100>;
+			clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_CPUCL0>;
+			enable-method = "psci";
+			#cooling-cells = <2>;
+			operating-points-v2 = <&cpucl0_opp_table>;
+			capacity-dmips-mhz = <250>;
+			cpu-idle-states = <&ananke_cpu_sleep>;
+		};
+
+		cpu2: cpu@200 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x0200>;
+			clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_CPUCL0>;
+			enable-method = "psci";
+			#cooling-cells = <2>;
+			operating-points-v2 = <&cpucl0_opp_table>;
+			capacity-dmips-mhz = <250>;
+			cpu-idle-states = <&ananke_cpu_sleep>;
+		};
+
+		cpu3: cpu@300 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x0300>;
+			clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_CPUCL0>;
+			enable-method = "psci";
+			#cooling-cells = <2>;
+			operating-points-v2 = <&cpucl0_opp_table>;
+			capacity-dmips-mhz = <250>;
+			cpu-idle-states = <&ananke_cpu_sleep>;
+		};
+
+		cpu4: cpu@400 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a78";
+			reg = <0x0400>;
+			clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_CPUCL1>;
+			enable-method = "psci";
+			#cooling-cells = <2>;
+			operating-points-v2 = <&cpucl1_opp_table>;
+			capacity-dmips-mhz = <927>;
+			cpu-idle-states = <&hercules_cpu_sleep>;
+		};
+
+		cpu5: cpu@500 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a78";
+			reg = <0x0500>;
+			clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_CPUCL1>;
+			enable-method = "psci";
+			#cooling-cells = <2>;
+			operating-points-v2 = <&cpucl1_opp_table>;
+			capacity-dmips-mhz = <927>;
+			cpu-idle-states = <&hercules_cpu_sleep>;
+		};
+
+		cpu6: cpu@600 {
+			device_type = "cpu";
+			compatible = "arm,cortex-x1";
+			reg = <0x0600>;
+			clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_CPUCL2>;
+			enable-method = "psci";
+			#cooling-cells = <2>;
+			operating-points-v2 = <&cpucl2_opp_table>;
+			capacity-dmips-mhz = <1024>;
+			cpu-idle-states = <&hera_cpu_sleep>;
+		};
+
+		cpu7: cpu@700 {
+			device_type = "cpu";
+			compatible = "arm,cortex-x1";
+			reg = <0x0700>;
+			clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_CPUCL2>;
+			enable-method = "psci";
+			#cooling-cells = <2>;
+			operating-points-v2 = <&cpucl2_opp_table>;
+			capacity-dmips-mhz = <1024>;
+			cpu-idle-states = <&hera_cpu_sleep>;
+		};
+
+		idle-states {
+			entry-method = "psci";
+
+			ananke_cpu_sleep: cpu-ananke-sleep {
+				idle-state-name = "c2";
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x0010000>;
+				local-timer-stop;
+				entry-latency-us = <70>;
+				exit-latency-us = <160>;
+				min-residency-us = <2000>;
+			};
+
+			hercules_cpu_sleep: cpu-hercules-sleep {
+				idle-state-name = "c2";
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x0010000>;
+				local-timer-stop;
+				entry-latency-us = <150>;
+				exit-latency-us = <190>;
+				min-residency-us = <2500>;
+			};
+
+			hera_cpu_sleep: cpu-hera-sleep {
+				idle-state-name = "c2";
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x0010000>;
+				local-timer-stop;
+				entry-latency-us = <235>;
+				exit-latency-us = <220>;
+				min-residency-us = <3500>;
+			};
+		};
+	};
+
+	/*
+	 * Downstream throttles with a PID governor from 100C. With step_wise,
+	 * start at 80C and force a big step at 92C; power off at 110C.
+	 */
+	thermal-zones {
+		big-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <1000>;
+			thermal-sensors = <&acpm_tmu 0>;
+
+			trips {
+				big_alert: trip-alert {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				big_emergency: trip-emergency {
+					temperature = <92000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				trip-hot {
+					temperature = <100000>;
+					hysteresis = <5000>;
+					type = "hot";
+				};
+
+				trip-critical {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&big_alert>;
+					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				/* the X1 heats ~25C/s at top OPPs; drop straight down */
+				map1 {
+					trip = <&big_emergency>;
+					cooling-device = <&cpu6 9 THERMAL_NO_LIMIT>,
+							 <&cpu7 9 THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+
+		mid-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <1000>;
+			thermal-sensors = <&acpm_tmu 1>;
+
+			trips {
+				mid_alert: trip-alert {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				mid_emergency: trip-emergency {
+					temperature = <92000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				trip-hot {
+					temperature = <100000>;
+					hysteresis = <5000>;
+					type = "hot";
+				};
+
+				trip-critical {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&mid_alert>;
+					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				/* the X1 heats ~25C/s at top OPPs; drop straight down */
+				map1 {
+					trip = <&mid_emergency>;
+					cooling-device = <&cpu4 4 THERMAL_NO_LIMIT>,
+							 <&cpu5 4 THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+
+		little-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <1000>;
+			thermal-sensors = <&acpm_tmu 2>;
+
+			trips {
+				little_alert: trip-alert {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				little_emergency: trip-emergency {
+					temperature = <92000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				trip-hot {
+					temperature = <100000>;
+					hysteresis = <5000>;
+					type = "hot";
+				};
+
+				trip-critical {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&little_alert>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				/* the X1 heats ~25C/s at top OPPs; drop straight down */
