+	S2MPG12_REG("ldo14m", S2MPG12_LDO14, 700000, 25000, 64, 0x39, 0x39, GENMASK(7, 6), S2MPG12_ENABLE_TIME_LDO),
+	S2MPG12_REG("ldo15m", S2MPG12_LDO15, 300000, 12500, 128, 0x3a, 0x49, GENMASK(1, 0), S2MPG12_ENABLE_TIME_LDO),
