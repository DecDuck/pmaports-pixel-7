+++ b/drivers/gpu/drm/sysfb/simpledrm.c
@@ -9,6 +9,7 @@
 #include <linux/overflow.h>
 #include <linux/platform_data/simplefb.h>
 #include <linux/platform_device.h>
+#include <linux/dma-mapping.h>
 #include <linux/pm.h>
 #include <linux/pm_domain.h>
 #include <linux/regulator/consumer.h>
@@ -574,8 +575,47 @@ static const u64 simpledrm_primary_plane_format_modifiers[] = {
 	DRM_SYSFB_PLANE_FORMAT_MODIFIERS,
 };
 
+/*
+ * In render-only setups a non-coherent GPU writes our buffers directly to
+ * memory, but we copy them to the framebuffer with the CPU. Invalidate the
+ * CPU caches for the buffer first, or the copy can contain stale data.
+ */
+static bool simpledrm_gpu_sync;
+module_param_named(gpu_sync, simpledrm_gpu_sync, bool, 0444);
+MODULE_PARM_DESC(gpu_sync, "Invalidate CPU caches before copying buffers (non-coherent render GPUs)");
+
+static void simpledrm_primary_plane_helper_atomic_update(struct drm_plane *plane,
+							  struct drm_atomic_commit *state)
+{
+	struct drm_plane_state *plane_state = drm_atomic_get_new_plane_state(state, plane);
+	struct drm_framebuffer *fb = plane_state->fb;
+	unsigned int i;
+
+	if (simpledrm_gpu_sync && fb) {
+		for (i = 0; i < fb->format->num_planes; i++) {
+			struct drm_gem_object *obj = drm_gem_fb_get_obj(fb, i);
+			struct sg_table *sgt;
+
+			if (!obj || drm_gem_is_imported(obj))
+				continue;
+
+			sgt = drm_gem_shmem_get_pages_sgt(to_drm_gem_shmem_obj(obj));
+			if (!IS_ERR(sgt))
+				dma_sync_sgtable_for_cpu(plane->dev->dev, sgt,
+							 DMA_FROM_DEVICE);
+		}
+	}
+
+	drm_sysfb_plane_helper_atomic_update(plane, state);
+}
+
 static const struct drm_plane_helper_funcs simpledrm_primary_plane_helper_funcs = {
-	DRM_SYSFB_PLANE_HELPER_FUNCS,
+	.begin_fb_access = drm_sysfb_plane_helper_begin_fb_access,
+	.end_fb_access = drm_gem_end_shadow_fb_access,
+	.atomic_check = drm_sysfb_plane_helper_atomic_check,
+	.atomic_update = simpledrm_primary_plane_helper_atomic_update,
+	.atomic_disable = drm_sysfb_plane_helper_atomic_disable,
+	.get_scanout_buffer = drm_sysfb_plane_helper_get_scanout_buffer,
 };
 
 static const struct drm_plane_funcs simpledrm_primary_plane_funcs = {
@@ -927,6 +967,13 @@ static int simpledrm_probe(struct platform_device *pdev)
 	struct drm_device *dev;
 	int ret;
 
+	/* buffers can live anywhere in RAM; avoid swiotlb bounces on sync */
+	if (simpledrm_gpu_sync) {
+		ret = dma_coerce_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(64));
+		if (ret)
+			return ret;
+	}
+
 	sdev = simpledrm_device_create(&simpledrm_driver, pdev);
 	if (IS_ERR(sdev))
 		return PTR_ERR(sdev);
