+		interrupt-controller;
+		reg = <0x0 0x10400000 0x10000>,		/* GICD */
+		      <0x0 0x10440000 0x100000>;	/* GICR * 8 */
+		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	/*
+	 * PMU_ALIVE is EL3-write-only like on gs101; downstream gs201 uses the
+	 * same SMC (0x82000504) the mainline gs101 PMU driver uses.
+	 * pmu-intr-gen layout matches gs101 (downstream flexpmu_cal_cpu_gs201.h).
+	 */
+	apm_sram: sram@18500000 {
+		compatible = "mmio-sram";
+		reg = <0x0 0x18500000 0x48000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x0 0x18500000 0x48000>;
+	};
+
+	firmware {
+		/* Same ACPM protocol and SRAM init data offset as gs101 */
+		acpm_ipc: power-management {
+			compatible = "google,gs201-acpm-ipc";
+			#clock-cells = <1>;
+			mboxes = <&ap2apm_mailbox>;
+			shmem = <&apm_sram>;
+
+			/* TMU sensors: 0 BIG, 1 MID, 2 LITTLE, 3 G3D, 4 ISP, 5 TPU, 6 AUR */
+			acpm_tmu: thermal-sensor {
+				compatible = "google,gs201-acpm-tmu";
+				#thermal-sensor-cells = <1>;
